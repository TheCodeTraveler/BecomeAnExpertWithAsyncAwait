@model IReadOnlyList<Checkpoint>?
@{
    var isSignedIn = User.Identity?.IsAuthenticated is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Principal Challenge</title>
    <style>
        body { margin: 0; padding: 32px 16px; font-family: "Segoe UI", system-ui, sans-serif; background: #f4f6f8; color: #1d2328; }
        main { max-width: 1200px; margin: 0 auto; }
        h1 { margin: 0 0 4px; }
        h2 { margin: 0 0 12px; font-size: 1.1rem; }
        p { margin: 0 0 12px; line-height: 1.5; }
        code { font-family: Consolas, Menlo, monospace; font-size: 0.9em; }
        section { margin-top: 20px; padding: 20px; border: 1px solid #d5dbe0; border-radius: 8px; background: #fff; }
        .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0 20px; }
        input { padding: 8px; font: inherit; }
        button, .button { display: inline-block; padding: 8px 16px; border: 0; border-radius: 6px; background: #5c2d91; color: #fff; font: inherit; text-decoration: none; cursor: pointer; }
        button.secondary { background: #6b7780; }
        .table-scroll { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; border-bottom: 1px solid #e3e7ea; text-align: left; vertical-align: top; }
        th small { display: block; font-weight: normal; color: #6b7780; }
        .name { padding: 2px 8px; border-radius: 12px; background: #dcf2e3; color: #11602f; font-weight: 600; }
        .null { padding: 2px 8px; border-radius: 12px; background: #fbe1e1; color: #9b1c1c; font-family: Consolas, Menlo, monospace; }
    </style>
</head>
<body>
<main>
    <h1>Who is the signed-in user?</h1>
    <p>3. .NET Internals &middot; Principal Challenge</p>

    <div class="steps">
        <section>
            <h2>Step 1: Sign in</h2>
            @if (isSignedIn)
            {
                <p>You are signed in as <span class="name">@User.Identity?.Name</span></p>
                <form method="post" asp-controller="Account" asp-action="Logout">
                    <button type="submit" class="secondary">Sign out</button>
                </form>
            }
            else
            {
                <p>There is no password. The app stores the name you type in a sign-in cookie.</p>
                <form method="post" asp-controller="Account" asp-action="Login">
                    <input name="name" placeholder="Your first name" maxlength="40" required />
                    <button type="submit">Sign in</button>
                </form>
            }
        </section>

        <section>
            <h2>Step 2: Run the experiment</h2>
            @if (!isSignedIn)
            {
                <p>Sign in first.</p>
            }
            else if (Model is null)
            {
                <p><code>HomeController.RunExperiment()</code> asks for your name four different ways at four checkpoints. Write down your predictions before you click.</p>
                <a class="button" asp-controller="Home" asp-action="RunExperiment">Run the experiment</a>
            }
            else
            {
                <p>Compare the results below with your predictions, then select <strong>Run it again</strong>.</p>
                <a class="button" asp-controller="Home" asp-action="RunExperiment">Run it again</a>
            }
        </section>
    </div>

    @if (Model is not null)
    {
        <section>
            <h2>Results</h2>
            <p>Each cell shows the user name that expression returned at that checkpoint, or <span class="null">null</span>.</p>
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Checkpoint</th>
                            <th>Thread</th>
                            <th><code>Thread.<wbr />CurrentPrincipal</code><small>static property</small></th>
                            <th><code>httpContextAccessor.<wbr />HttpContext?.<wbr />User</code><small>injected IHttpContextAccessor</small></th>
                            <th><code>HttpContext.<wbr />User</code><small>controller property</small></th>
                            <th><code>signedInUser</code><small>local variable</small></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var checkpoint in Model)
                        {
                            <tr>
                                <td>@checkpoint.Name</td>
                                <td>@checkpoint.ThreadId</td>
                                <td><span class="@(checkpoint.ThreadCurrentPrincipal is null ? "null" : "name")">@(checkpoint.ThreadCurrentPrincipal ?? "null")</span></td>
                                <td><span class="@(checkpoint.HttpContextAccessorUser is null ? "null" : "name")">@(checkpoint.HttpContextAccessorUser ?? "null")</span></td>
                                <td><span class="@(checkpoint.ControllerHttpContextUser is null ? "null" : "name")">@(checkpoint.ControllerHttpContextUser ?? "null")</span></td>
                                <td><span class="@(checkpoint.SignedInUserVariable is null ? "null" : "name")">@(checkpoint.SignedInUserVariable ?? "null")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>
</body>
</html>