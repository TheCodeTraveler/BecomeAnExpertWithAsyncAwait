@page "/"
@inherits CheckoutPageBase

<PageTitle>OrderPortal · Checkout</PageTitle>

<div class="store">
    <header class="store-bar">
        <span class="store-logo"><span class="store-logo-mark" aria-hidden="true">◆</span> OrderPortal</span>
        <span class="store-event">Black Friday · Checkout war room</span>
    </header>

    <section class="store-hero">
        <p class="sale-tag">Doors open at midnight</p>
        <h1>Checkout load simulator</h1>
        <p class="store-summary">@OrderCount.ToString("N0") customers check out at once against the same singleton services, like the first minute of the sale.</p>

        <div class="store-actions">
            <button class="action" type="button" disabled="@IsBusy" @onclick="RunBurstAsync">
                @if (IsBusy)
                {
                    <span class="spinner" aria-hidden="true"></span>
                }
                @(IsBusy ? "Running" : $"Run {OrderCount} checkouts")
            </button>

            <button class="action secondary" type="button" disabled="@IsBusy" @onclick="ReserveStockAsync">
                Reserve stock
            </button>
        </div>
    </section>

    @if (Result is null && !IsBusy)
    {
        <section class="store-panel">
            <h2>What to look for</h2>
            <p class="store-hint">Run the burst. Every card that turns red is a bug in a service that looked fine when one request hit it at a time. Then press Reserve stock and watch how long it takes.</p>
        </section>
    }

    @if (Result is not null)
    {
        <section class="store-panel">
            <h2>Checkout results</h2>
            <p class="store-hint">Every number below has a known correct value. Anything that does not match is a race condition.</p>

            <div class="result-grid">
                <div class="result-card @(Result.OrdersPlaced == OrderCount ? "ok" : "bad")">
                    <span class="result-label">Orders recorded</span>
                    <span class="result-value">@Result.OrdersPlaced</span>
                    <span class="result-note">expected @OrderCount</span>
                </div>

                <div class="result-card @(Result.Revenue == ExpectedRevenue ? "ok" : "bad")">
                    <span class="result-label">Revenue</span>
                    <span class="result-value">@Result.Revenue.ToString("C0")</span>
                    <span class="result-note">expected @ExpectedRevenue.ToString("C0")</span>
                </div>

                <div class="result-card @(Result.TaxRateBuilds == 1 ? "ok" : "bad")">
                    <span class="result-label">Tax table builds</span>
                    <span class="result-value">@Result.TaxRateBuilds</span>
                    <span class="result-note">expected 1</span>
                </div>

                <div class="result-card">
                    <span class="result-label">Elapsed</span>
                    <span class="result-value">@Result.Elapsed.TotalSeconds.ToString("F2")s</span>
                    <span class="result-note">@Result.TaxRateLookups tax lookups</span>
                </div>
            </div>
        </section>
    }

    @if (StockMessage is not null)
    {
        <section class="store-panel">
            <h2>Stock reservation</h2>
            <p class="store-hint">Reserving stock writes an audit entry while holding the ledger lock.</p>
            <pre class="log">@StockMessage</pre>
        </section>
    }
</div>
